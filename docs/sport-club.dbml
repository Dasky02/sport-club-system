// Logický model podle požadavků ročníkového projektu; viz requirements.md.
// Celý soubor vložte do dbdiagram.io. Nejde o migraci ani implementaci.
Project sport_club {
  database_type: 'PostgreSQL'
  Note: 'Logický návrh pro jeden klub a více sportů v jedné instalaci, například fotbal a basketbal současně. Sportovní konfiguraci spravuje administrátor v aplikaci bez změn kódu či schématu a bez ručního SQL. Popis pravidel a zálohování: database.md.'
}

Enum user_role {
  USER
  ADMIN
}
Enum account_type {
  STANDARD
  CHILD
}
Enum event_type {
  TRAINING
  MATCH
  OTHER
}
Enum event_status {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}
Enum availability_status {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE
}
Enum nomination_status {
  NOT_SELECTED
  SELECTED
  RESERVE
}
Enum attendance_status {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}
Enum statistic_value_type {
  INTEGER
  DECIMAL
  BOOLEAN
  TEXT
}
Enum statistic_aggregation {
  SUM
  AVG
  MIN
  MAX
  COUNT
  COUNT_TRUE
  NONE
}
Enum notification_type {
  EVENT_CREATED
  EVENT_CHANGED
  EVENT_CANCELLED
  NOMINATION_PUBLISHED
  NOMINATION_CHANGED
  FEE_DUE_SOON
  FEE_OVERDUE
}

Enum score_mode {
  SUM_SCORE
  WON_PARTS
}
Enum match_ending {
  REGULATION
  OVERTIME
  SHOOTOUT
}
Enum match_decision {
  REGULAR
  FORFEIT_HOME
  FORFEIT_AWAY
}
Enum result_revision_status {
  DRAFT
  CONFIRMED
  ANNULLED
}
Enum head_to_head_missing_policy {
  REQUIRE_COMPLETE
  PLAYED_ONLY
}
Enum match_outcome {
  WIN
  DRAW
  LOSS
}
Enum ranking_metric {
  POINTS
  WINS
  SCORE_DIFFERENCE
  SCORE_FOR
  SCORE_RATIO
  PART_SCORE_DIFFERENCE
  PART_SCORE_RATIO
  HEAD_TO_HEAD_POINTS
  HEAD_TO_HEAD_SCORE_DIFFERENCE
  HEAD_TO_HEAD_SCORE_FOR
}
Enum sort_direction {
  ASC
  DESC
}

Table persons {
  id uuid [pk]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  birth_date date
  email varchar(254)
  phone varchar(40)
  Note: 'Osobní údaje hráčů, trenérů a zástupců. Hráč musí mít datum narození; kontroluje backend. Jména ani rodinné kontakty nejsou jedinečné.'
}

Table users {
  id uuid [pk]
  person_id uuid [not null, unique, ref: - persons.id]
  username varchar(50) [not null, unique]
  password_hash varchar(100) [not null]
  role user_role [not null, default: 'USER']
  account_type account_type [not null, default: 'STANDARD']
  enabled boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  checks {
    `updated_at >= created_at`
    `account_type <> 'CHILD' OR role = 'USER'`
  }
  Note: 'Přihlašovací účet s rolí USER nebo ADMIN a typem STANDARD/CHILD. STANDARD může kombinovat administraci, trenérské přiřazení, vlastní profil i rodičovství. CHILD nesmí být ADMIN ani získat trenérskou či rodičovskou schopnost; globální COACH/PLAYER/PARENT role se nepřidávají. USER bez vazeb nemá přístup k týmovým datům. Přihlašovací pole odpovídají skeletonu; převod jeho rolí vyžaduje novou migraci. V1 používá varchar s CHECK, zde je role logický enum. CHILD založí server s enabled=false a administrátor aktivuje až po ověření vlastního player_profile se stejným person_id a nejméně jedné schválené neodvolané vazby na osobu s enabled STANDARD účtem. Account_type ani enabled nelze eskalovat selfservice. Po ztrátě poslední takové vazby či deaktivaci posledního rodiče backend ve stejné transakci nastaví enabled=false dítěte a invaliduje sessions; nový přístup vždy kontroluje enabled, vlastní profil a aktuální rodičovskou podmínku autoritativně. CHILD má zákaz všech finančních dat, API, exportů, součtů a FEE notifikací i pro vlastní příspěvky. Evidovaný hráč bez účtu rodiče nevyžaduje.'
}

Table player_profiles {
  id uuid [pk]
  person_id uuid [not null, unique, ref: - persons.id]
  Note: 'Hráčský profil, který může existovat bez účtu. Účet se dohledá přes stejné person_id; jména a kontakty jsou v persons.'
}

Table guardian_links {
  guardian_person_id uuid [not null, ref: > persons.id]
  player_id uuid [not null, ref: > player_profiles.id]
  granted_by uuid [not null, ref: > users.id]
  granted_at timestamptz [not null]
  revoked_at timestamptz
  indexes {
    (player_id, guardian_person_id)
    (guardian_person_id, player_id) [pk]
  }
  checks {
    `revoked_at IS NULL OR revoked_at >= granted_at`
  }
  Note: 'Zástupce může být evidován bez účtu; přístup získává teprve účet se shodným users.person_id. Vazba není pro hráče povinná. Zástupce s účtem musí být STANDARD, CHILD nemůže získat rodičovskou schopnost. Vazbu schvaluje administrátor; revoked_at ukončí oprávnění a u CHILD bez jiného enabled STANDARD zástupce zablokuje účet i sessions. Nové schválení aktualizuje granted_by a granted_at a vymaže revoked_at. Změna pod zámkem klubu uzavře účasti v konverzacích bez jiného oprávnění. Audit obsahuje oba sloupce PK.'
}

Table club {
  id smallint [pk, default: 1]
  name varchar(120) [not null]
  setup_completed_at timestamptz
  setup_completed_by uuid [ref: >? users.id]
  checks {
    `id = 1`
    `num_nonnulls(setup_completed_at, setup_completed_by) IN (0, 2)`
  }
  Note: 'Jeden řádek s id = 1, vytvořený před klubovými operacemi. Klub současně spravuje více sportů z tabulky sports; každý tým má právě jeden sport. Plánovaný jednorázový setup povýší přihlášený enabled STANDARD účet na prvního ADMIN pouze s instalačním tokenem z prostředí a pokud setup_completed_at chybí; pod FOR UPDATE zapíše oba setup sloupce, roli a audit atomicky. Token se do databáze neukládá a po dokončení je nepoužitelný. Veřejná registrace vždy vytváří USER; první registrovaný není automaticky ADMIN. Tentýž účet může získat trenérské přiřazení, samostatný druhý administrátor není nutný. Řádek slouží také jako zámek: FOR SHARE při čtení, FOR UPDATE při zápisu, vždy před kontrolou oprávnění. Postup je v database.md.'
}

Table sports {
  id uuid [pk]
  code varchar(40) [not null, unique]
  name varchar(100) [not null]
  active boolean [not null, default: true]
  checks {
    `length(trim(code)) > 0`
    `length(trim(name)) > 0`
  }
  Note: 'Sporty spravuje administrátor v UI bez změn kódu nebo schématu. Fotbal i basketbal mohou existovat současně v jedné DB. Kód je stabilní; deaktivace zachová historii. Použitý sport týmu, soutěže, formátu ani definice se nepřepisuje.'
}

Table seasons {
  id uuid [pk]
  name varchar(100) [not null, unique]
  starts_on date [not null]
  ends_on date [not null]
  archived boolean [not null, default: false]
  checks {
    `ends_on > starts_on`
  }
  Note: 'Interval [starts_on, ends_on) v Europe/Prague. Po použití v team_seasons, competition_seasons, events nebo fee_assessments se hranice nemění. Celá akce musí ležet v sezóně; konec smí odpovídat její horní hranici. Změny používají zámek klubu. Archivace uchová soupisky, výsledky a statistiky.'
}

Table teams {
  id uuid [pk]
  sport_id uuid [not null, ref: > sports.id]
  name varchar(120) [not null]
  is_club_team boolean [not null, default: true]
  Note: 'Klubový tým nebo externí soupeř právě jednoho sportu. Externí týmy mají sezónní záznamy, ale nemají klubové hráče ani trenéry. Použitou příslušnost ke klubu nelze přepsat.'
}

Table team_seasons {
  id uuid [pk]
  team_id uuid [not null, ref: > teams.id]
  season_id uuid [not null, ref: > seasons.id]
  display_name varchar(120) [not null]
  indexes {
    (team_id, season_id) [unique]
  }
  Note: 'Název týmu v sezóně, společný pro všechny její soutěže. Soupisky a trenéry mají pouze klubové týmy. Team_id a season_id se po založení nemění; oprava vyžaduje nový řádek.'
}

Table player_team_memberships {
  id uuid [pk]
  team_season_id uuid [not null, ref: > team_seasons.id]
  player_id uuid [not null, ref: > player_profiles.id]
  valid_from date [not null]
  valid_to date
  indexes {
    (player_id, team_season_id)
    (team_season_id, player_id, valid_from) [unique]
  }
  checks {
    `valid_to IS NULL OR valid_to > valid_from`
  }
  Note: 'Členství v intervalu [valid_from, valid_to); NULL valid_to znamená konec sezóny. Překryvy stejné dvojice zakáže PostgreSQL EXCLUDE. Player_id a team_season_id se nemění. Změna intervalu nebo odstranění pod zámkem klubu musí zachovat historické účasti a vyřešit neplatné budoucí účasti podle database.md.'
}

Table coach_team_memberships {
  id uuid [pk]
  team_season_id uuid [not null, ref: > team_seasons.id]
  coach_user_id uuid [not null, ref: > users.id]
  valid_from date [not null]
  valid_to date
  indexes {
    (coach_user_id, team_season_id)
    (team_season_id, coach_user_id, valid_from) [unique]
  }
  checks {
    `valid_to IS NULL OR valid_to > valid_from`
  }
  Note: 'Trenérské přiřazení v intervalu [valid_from, valid_to); NULL valid_to znamená konec sezóny. Překryvy stejné dvojice zakáže EXCLUDE. Přiřazení může mít STANDARD účet USER i ADMIN bez zvláštní systémové role COACH; CHILD přiřazení nikdy nedostane; jediný účet tak může klub spravovat i trénovat. Trenér může mít více týmů a tým více trenérů. Coach_user_id a team_season_id se nemění. Změna pod zámkem klubu znovu ověří oprávnění a uzavře neoprávněné konverzační účasti; autorství zpráv zůstává. Osobní údaje jsou v persons.'
}

Table events {
  version bigint [not null, default: 0, note: 'Verze pro kontrolu souběžných změn; každý zápis ji zvýší.']
  id uuid [pk]
  season_id uuid [not null, ref: > seasons.id]
  type event_type [not null]
  title varchar(160) [not null]
  description text
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  location varchar(200)
  status event_status [not null, default: 'DRAFT']
  availability_deadline timestamptz
  nomination_published_at timestamptz
  created_by uuid [not null, ref: > users.id]
  indexes {
    (season_id, starts_at)
  }
  checks {
    `version >= 0`
    `ends_at > starts_at`
    `availability_deadline IS NULL OR availability_deadline <= starts_at`
  }
  Note: 'Trénink, zápas nebo jiná akce. Celý termín včetně konceptů a externích zápasů leží mezi půlnocemi hranic sezóny v Europe/Prague. Přesun do jiné sezóny vyžaduje zrušení neodehrané akce a založení nové. Season_id a type lze opravit jen u DRAFT bez týmů, účastníků, zápasu a oznámení. Zápisy akce a navázaných dat používají zámek klubu; změna termínu nebo vazeb vyžaduje kontrolu podle database.md.'
}

Table event_teams {
  event_id uuid [not null, ref: > events.id]
  team_season_id uuid [not null, ref: > team_seasons.id]
  indexes {
    (team_season_id, event_id)
    (event_id, team_season_id) [pk]
  }
  Note: 'Akce může patřit více týmům stejné sezóny.'
}

Table event_participants {
  event_id uuid [not null]
  player_id uuid [not null, ref: > player_profiles.id]
  team_season_id uuid [not null]
  version bigint [not null, default: 0]
  availability availability_status
  availability_comment varchar(500)
  availability_by uuid [ref: >? users.id]
  availability_at timestamptz
  nomination nomination_status
  nomination_by uuid [ref: >? users.id]
  nomination_at timestamptz
  attendance attendance_status
  attendance_comment varchar(500)
  attendance_by uuid [ref: >? users.id]
  attendance_at timestamptz
  played boolean
  played_by uuid [ref: >? users.id]
  played_at timestamptz
  withdrawn_at timestamptz
  withdrawal_reason varchar(500)
  indexes {
    (player_id, event_id)
    (event_id, player_id) [pk]
  }
  checks {
    `version >= 0`
    `num_nonnulls(availability, availability_by, availability_at) IN (0, 3)`
    `availability IS NOT NULL OR availability_comment IS NULL`
    `num_nonnulls(nomination, nomination_by, nomination_at) IN (0, 3)`
    `num_nonnulls(attendance, attendance_by, attendance_at) IN (0, 3)`
    `attendance IS NOT NULL OR attendance_comment IS NULL`
    `num_nonnulls(played, played_by, played_at) IN (0, 3)`
    `played IS DISTINCT FROM TRUE OR (attendance IS NOT NULL AND attendance IN ('PRESENT', 'LATE'))`
    `(withdrawn_at IS NULL AND withdrawal_reason IS NULL) OR (withdrawn_at IS NOT NULL AND withdrawal_reason IS NOT NULL AND length(trim(withdrawal_reason)) > 0 AND attendance IS NULL AND played IS NULL)`
  }
  Note: 'Hráč je na akci veden za jeden historický tým. Dostupnost, nominace, docházka a nastoupení mají vlastní stav, autora a čas. NULL znamená nezapsáno; UNKNOWN, NOT_SELECTED a false jsou výslovné hodnoty. Version chrání celý řádek, požadavek smí měnit jen povolenou skupinu polí. Played se zapisuje pouze u MATCH, nezávisle na docházce. Withdrawn_at vyřadí budoucí účast a zachová dostupnost i nominaci; důvod a audit zapisuje server. Podmínky vyřazení a opravy jsou v database.md.'
}

Table competitions {
  id uuid [pk]
  sport_id uuid [not null, ref: > sports.id]
  name varchar(160) [not null]
}

Table competition_seasons {
  id uuid [pk]
  version bigint [not null, default: 0]
  competition_id uuid [not null, ref: > competitions.id]
  season_id uuid [not null, ref: > seasons.id]
  match_format_id uuid [not null, ref: > match_formats.id]
  results_revision bigint [not null, default: 0]
  head_to_head_missing_policy head_to_head_missing_policy [not null, default: 'REQUIRE_COMPLETE']
  head_to_head_meetings_per_pair integer [not null, default: 1]
  restart_head_to_head_on_subgroup boolean [not null, default: true]
  locked_at timestamptz
  indexes {
    (competition_id, season_id) [unique]
    (id, match_format_id) [unique]
  }
  checks {
    `version >= 0 AND results_revision >= 0`
    `head_to_head_meetings_per_pair > 0`
  }
  Note: 'Bodování a kritéria pořadí pro ročník soutěže jednoho sportu; formát i přihlášené týmy musejí mít stejný sport. Více ročníků může sdílet formát a mít jiné bodování. Identita a match_format_id se po založení nemění. První část nebo výsledek trvale nastaví locked_at; bodování, kontumace, řazení a H2H politika se pak nemění. Aktivace, oprava či anulování výsledku atomicky zvýší results_revision a zneplatní stará ruční rozhodnutí pořadí. REQUIRE_COMPLETE vyžaduje alespoň head_to_head_meetings_per_pair potvrzených vzájemných zápasů pro každou dvojici skupiny, jinak se H2H blok přeskočí; PLAYED_ONLY použije všechny odehrané vzájemné zápasy.'
}

Table match_formats {
  id uuid [pk]
  sport_id uuid [not null, ref: > sports.id]
  version bigint [not null, default: 0]
  name varchar(120) [not null]
  score_mode score_mode [not null]
  allow_draw boolean [not null]
  periods_required boolean [not null, default: false]
  period_label varchar(100) [not null]
  regulation_period_count integer
  wins_required integer
  allow_overtime boolean [not null, default: false]
  allow_shootout boolean [not null, default: false]
  shootout_winner_bonus integer [not null, default: 0]
  friendly_forfeit_loser_score integer [not null, default: 0]
  friendly_forfeit_winner_score integer [not null, default: 1]
  locked_at timestamptz
  checks {
    `version >= 0 AND shootout_winner_bonus >= 0`
    `friendly_forfeit_loser_score >= 0 AND friendly_forfeit_winner_score > friendly_forfeit_loser_score`
    `length(trim(period_label)) > 0`
    `regulation_period_count IS NULL OR regulation_period_count > 0`
    `allow_shootout OR shootout_winner_bonus = 0`
    `(score_mode = 'SUM_SCORE' AND wins_required IS NULL) OR (score_mode = 'WON_PARTS' AND periods_required AND wins_required IS NOT NULL AND wins_required > 0 AND NOT allow_draw AND NOT allow_overtime AND NOT allow_shootout AND regulation_period_count IS NULL)`
  }
  Note: 'Způsob výpočtu výsledku pro jeden sport, nezávislý na bodování soutěže. Friendly_forfeit skóre platí pouze pro přátelský zápas; soutěž používá vlastní competition_forfeit_rules. Určuje název částí, případně jejich počet; fáze jsou REGULATION, OVERTIME a SHOOTOUT. První část nebo výsledek formát trvale uzamkne. Změna parametrů vyžaduje nový formát.'
}

Table competition_point_rules {
  id uuid [pk]
  competition_season_id uuid [not null, ref: > competition_seasons.id]
  outcome match_outcome [not null]
  ending match_ending [not null]
  own_score_min integer
  own_score_max integer
  opponent_score_min integer
  opponent_score_max integer
  points integer [not null]
  indexes { competition_season_id }
  checks {
    `points >= 0`
    `own_score_min IS NULL OR own_score_min >= 0`
    `own_score_max IS NULL OR own_score_max >= 0`
    `opponent_score_min IS NULL OR opponent_score_min >= 0`
    `opponent_score_max IS NULL OR opponent_score_max >= 0`
    `own_score_min IS NULL OR own_score_max IS NULL OR own_score_min <= own_score_max`
    `opponent_score_min IS NULL OR opponent_score_max IS NULL OR opponent_score_min <= opponent_score_max`
  }
  Note: 'Body pouze pro REGULAR výsledek jedné strany podle výhry, remízy či prohry, ukončení a rozsahů konečného skóre včetně hranic. Kontumace používá samostatné competition_forfeit_rules, nikoli LOSS podle skóre. NULL hranice je neomezená. Konfigurace odmítne překryvy; při dokončení musí každé straně odpovídat právě jedno pravidlo. Chybějící pravidlo nemá výchozí body. Uživatelské SQL a skripty se nepoužívají.'
}

Table competition_forfeit_rules {
  competition_season_id uuid [not null, ref: > competition_seasons.id]
  decision match_decision [not null]
  home_score integer [not null]
  away_score integer [not null]
  home_points integer [not null]
  away_points integer [not null]
  indexes { (competition_season_id, decision) [pk] }
  checks {
    `decision IN ('FORFEIT_HOME', 'FORFEIT_AWAY')`
    `home_score >= 0 AND away_score >= 0 AND home_points >= 0 AND away_points >= 0`
    `(decision = 'FORFEIT_HOME' AND home_score < away_score) OR (decision = 'FORFEIT_AWAY' AND away_score < home_score)`
  }
  Note: 'Administrátor určí konečné skóre a body obou stran pro kontumaci domácích či hostů. Příklad basketbalu FORFEIT_AWAY: skóre 20:0 a body 2:0, běžná prohra má nadále 1 bod. Kontumace je rozhodnutí, nikoli fáze zápasu; nevyžaduje fiktivní části ani nastoupení hráčů. Použitá pravidla jsou neměnná a nový ročník může mít jiné hodnoty.'
}

Table competition_ranking_criteria {
  competition_season_id uuid [not null, ref: > competition_seasons.id]
  priority integer [not null]
  metric ranking_metric [not null]
  direction sort_direction [not null, default: 'DESC']
  indexes {
    (competition_season_id, priority) [pk]
    (competition_season_id, metric) [unique]
  }
  checks { `priority > 0` }
  Note: 'Administrátor určuje pořadí metrik a směr řazení. SCORE pracuje s konečným skóre, PART_SCORE se skóre započítávaných částí a vyžaduje povinnou evidenci částí. Výpočet poměrů popisuje database.md. Zamčený ročník nedovoluje změny. HEAD_TO_HEAD_POINTS, HEAD_TO_HEAD_SCORE_DIFFERENCE a HEAD_TO_HEAD_SCORE_FOR se počítají pouze ze vzájemných zápasů právě shodné skupiny. H2H kritéria tvoří souvislý blok; pořadí a směr určuje priority. Politika úplnosti a opakování od začátku bloku pro nově vzniklou podskupinu jsou v competition_seasons. Po úplné shodě zůstává sdílené pořadí, nebo administrátor uloží auditované competition_tie_decisions bez změny bodů.'
}

Table competition_entries {
  competition_season_id uuid [not null, ref: > competition_seasons.id]
  team_season_id uuid [not null, ref: > team_seasons.id]
  indexes {
    (team_season_id, competition_season_id)
    (competition_season_id, team_season_id) [pk]
  }
  Note: 'Přihláška sezónního týmu do ročníku stejné sezóny. Historický název je v team_seasons.'
}

Table competition_tie_decisions {
  id uuid [pk]
  competition_season_id uuid [not null, ref: > competition_seasons.id]
  results_revision bigint [not null]
  supersedes_decision_id uuid [unique]
  reason varchar(500) [not null]
  decided_by uuid [not null, ref: > users.id]
  decided_at timestamptz [not null]
  indexes {
    (id, competition_season_id) [unique]
    (id, competition_season_id, results_revision) [unique]
    (competition_season_id, results_revision)
  }
  checks {
    `results_revision >= 0`
    `length(trim(reason)) > 0`
    `supersedes_decision_id IS NULL OR supersedes_decision_id <> id`
  }
  Note: 'Neměnné auditované rozhodnutí až po shodě všech konfigurovaných kritérií. Entries obsahují právě celou shodnou skupinu bez duplicit. Platí jen pro stejný competition_seasons.results_revision a nemění body, skóre ani kritéria. Oprava je nový řádek supersedes_decision_id stejné skupiny a kontextu; použije se poslední nenahrazené rozhodnutí. Backend pod zámkem klubu brání souběžným či překrývajícím se rozhodnutím a ověřuje úplnost skupiny.'
}

Table competition_tie_decision_entries {
  decision_id uuid [not null]
  competition_season_id uuid [not null]
  team_season_id uuid [not null]
  position integer [not null]
  indexes {
    (decision_id, team_season_id) [pk]
    (decision_id, position) [unique]
  }
  checks { `position > 0` }
  Note: 'Pořadí týmů uvnitř celé nerozhodnuté skupiny, souvisle od 1. Složené FK vynutí příslušnost rozhodnutí i týmu ke stejnému ročníku. Nejde o ruční přepis soutěžních bodů.'
}

Table matches {
  event_id uuid [pk]
  version bigint [not null, default: 0]
  competition_season_id uuid
  match_format_id uuid [not null, ref: > match_formats.id]
  home_team_season_id uuid [not null, ref: > team_seasons.id]
  away_team_season_id uuid [not null, ref: > team_seasons.id]
  active_result_revision_id uuid
  checks {
    `version >= 0`
    `home_team_season_id <> away_team_season_id`
  }
  Note: 'Identita zápasu; skóre, rozhodnutí, části a statistiky jsou v revizích. NULL competition_season_id je přátelský zápas; složené FK používají MATCH SIMPLE. Strany, formát a ročník mají stejný sport i sezónu akce, klubové strany přesně odpovídají event_teams. Po založení se formát a ročník nemění; strany jsou neměnné po první revizi či nastoupení. Active_result_revision_id může ukazovat pouze na CONFIRMED revizi stejného zápasu, jinak je NULL; přepnutí a zvýšení results_revision proběhnou pod zámkem klubu. Tabulky a souhrny používají pouze tento aktivní potvrzený výsledek u COMPLETED zápasů, nikdy všechny revize.'
}

Table match_result_revisions {
  id uuid [pk]
  event_id uuid [not null, ref: > matches.event_id]
  revision integer [not null]
  status result_revision_status [not null, default: 'DRAFT']
  supersedes_revision_id uuid
  decision match_decision
  home_score integer
  away_score integer
  ending match_ending
  shootout_winner_home boolean
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  confirmed_by uuid [ref: >? users.id]
  confirmed_at timestamptz
  correction_reason varchar(500)
  indexes {
    (event_id, revision) [unique]
    (id, event_id) [unique]
    (event_id, status)
  }
  checks {
    `revision > 0`
    `status <> 'ANNULLED' OR supersedes_revision_id IS NOT NULL`
    `supersedes_revision_id IS NULL OR supersedes_revision_id <> id`
    `(revision = 1 AND supersedes_revision_id IS NULL) OR (revision > 1 AND supersedes_revision_id IS NOT NULL AND correction_reason IS NOT NULL AND length(trim(correction_reason)) > 0)`
    `num_nonnulls(decision, home_score, away_score) IN (0, 3)`
    `home_score IS NULL OR home_score >= 0`
    `away_score IS NULL OR away_score >= 0`
    `decision IS NULL OR decision = 'REGULAR' OR (decision = 'FORFEIT_HOME' AND home_score < away_score) OR (decision = 'FORFEIT_AWAY' AND away_score < home_score)`
    `decision IS NULL OR decision = 'REGULAR' OR (correction_reason IS NOT NULL AND length(trim(correction_reason)) > 0)`
    `(decision IS NULL AND ending IS NULL AND shootout_winner_home IS NULL) OR (decision IS NOT NULL AND ((decision = 'REGULAR' AND ending IS NOT NULL AND ((ending = 'SHOOTOUT' AND shootout_winner_home IS NOT NULL) OR (ending <> 'SHOOTOUT' AND shootout_winner_home IS NULL))) OR (decision IN ('FORFEIT_HOME', 'FORFEIT_AWAY') AND ending IS NULL AND shootout_winner_home IS NULL)))`
    `(status = 'DRAFT' AND confirmed_by IS NULL AND confirmed_at IS NULL) OR (status = 'CONFIRMED' AND decision IS NOT NULL AND confirmed_by IS NOT NULL AND confirmed_at IS NOT NULL AND confirmed_at >= created_at) OR (status = 'ANNULLED' AND decision IS NULL AND home_score IS NULL AND away_score IS NULL AND confirmed_by IS NOT NULL AND confirmed_at IS NOT NULL AND confirmed_at >= created_at AND correction_reason IS NOT NULL AND length(trim(correction_reason)) > 0)`
  }
  Note: 'Úplný historický snapshot výsledku. Na zápas je nejvýše jeden DRAFT; nová oprava vychází z poslední finální revize včetně ANNULLED. DRAFT lze dopracovat, po CONFIRMED se řádek, jeho části, hráči ani statistiky nikdy nepřepisují či nemažou. Oprava založí novou revizi se zkopírovanými a upravenými daty; původní potvrzená revize zůstává. Supersedes ukazuje na předchozí revizi stejného zápasu s nižším revision; backend vyžaduje aktuální základ a brání větvení potvrzené historie. ANNULLED je nový finální tombstone navazující na existující revizi, bez skóre a dětí; vyprázdní active_result_revision_id, nemaže staré hodnoty a nezůstane aktivním potvrzeným výsledkem. REGULAR používá ending a běžné bodování; FORFEIT_HOME/FORFEIT_AWAY převezmou skóre i body ze soutěžního pravidla, u přátelského zápasu skóre z friendly_forfeit formátu. Potvrzení po konci akce ověří konzistenci snapshotu v jedné transakci.'
}

Table match_periods {
  result_revision_id uuid [not null, ref: > match_result_revisions.id]
  period_number integer [not null]
  phase match_ending [not null, default: 'REGULATION']
  home_score integer [not null]
  away_score integer [not null]
  indexes { (result_revision_id, period_number) [pk] }
  checks {
    `period_number > 0`
    `home_score >= 0 AND away_score >= 0`
    `phase <> 'SHOOTOUT' OR home_score <> away_score`
  }
  Note: 'Části konkrétní revize REGULAR výsledku v časovém pořadí; při potvrzení souvislá čísla od 1. REGULATION a OVERTIME se sčítají, SHOOTOUT pouze určuje vítěze. Kontumace ani ANNULLED části nemají. Části potvrzené revize jsou neměnné; oprava vzniká pouze pod novou result_revision_id. Formát, počet, fáze a odvozené skóre ověřuje backend.'
}

Table match_result_players {
  result_revision_id uuid [not null]
  event_id uuid [not null]
  player_id uuid [not null]
  team_season_id uuid [not null, ref: > team_seasons.id]
  attendance attendance_status [not null]
  played boolean [not null]
  indexes {
    (result_revision_id, player_id) [pk]
    (event_id, player_id, result_revision_id)
  }
  checks { `NOT played OR attendance IN ('PRESENT', 'LATE')` }
  Note: 'Historický snapshot docházky a skutečného nastoupení za konkrétní tým v revizi. Při nové revizi se ověří živá účast v event_participants, členství a strany zápasu; ANNULLED nemá hráčské snapshoty. Pozdější oprava živé docházky nepřepisuje starý snapshot. Statistiky a počty startů oficiálně používají played z aktivní potvrzené revize. Backend brání statistice nehráče a potvrzené snapshoty nemění.'
}

Table statistic_definitions {
  id uuid [pk]
  sport_id uuid [not null, ref: > sports.id]
  version bigint [not null, default: 0]
  active boolean [not null, default: true]
  locked_at timestamptz
  checks { `version >= 0` }
  Note: 'Stabilní identita statistiky jednoho sportu. Aktuální nastavení je nejvyšší revision v statistic_definition_versions; založení definice vždy vytvoří i první verzi. Version chrání souběžnou změnu, locked_at po prvním použití navždy uzamkne význam. Deaktivace zachová historii. Sport definice musí odpovídat sportu zápasu. Nová revize může po použití změnit název; jiný typ, agregace, jednotka nebo meze vyžadují nové id definice.'
}

Table statistic_definition_versions {
  id uuid [pk]
  statistic_definition_id uuid [not null, ref: > statistic_definitions.id]
  revision integer [not null]
  name varchar(120) [not null]
  value_type statistic_value_type [not null]
  aggregation statistic_aggregation [not null]
  unit varchar(40)
  min_value numeric
  max_value numeric
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  indexes {
    (statistic_definition_id, revision) [unique]
    (id, statistic_definition_id) [unique]
  }
  checks {
    `revision > 0`
    `length(trim(name)) > 0`
    `(value_type IN ('INTEGER', 'DECIMAL') AND aggregation IN ('SUM', 'AVG', 'MIN', 'MAX', 'COUNT', 'NONE')) OR (value_type = 'BOOLEAN' AND aggregation IN ('COUNT_TRUE', 'COUNT', 'NONE')) OR (value_type = 'TEXT' AND aggregation IN ('COUNT', 'NONE'))`
    `value_type IN ('INTEGER', 'DECIMAL') OR (min_value IS NULL AND max_value IS NULL)`
    `min_value IS NULL OR max_value IS NULL OR min_value <= max_value`
    `value_type <> 'INTEGER' OR ((min_value IS NULL OR min_value = trunc(min_value)) AND (max_value IS NULL OR max_value = trunc(max_value)))`
    `min_value IS NULL OR min_value NOT IN ('NaN'::numeric, 'Infinity'::numeric, '-Infinity'::numeric)`
    `max_value IS NULL OR max_value NOT IN ('NaN'::numeric, 'Infinity'::numeric, '-Infinity'::numeric)`
  }
  Note: 'Append-only znění názvu, typu a validačních/agregačních pravidel. Staré hodnoty odkazují na přesnou verzi včetně tehdejšího názvu; změna aktuálního názvu tak nepřejmenuje minulost. Backend ověří reprezentovatelnost mezí v bigint/numeric(20,6) i shodu významu po locked_at; nic tiše nezaokrouhluje. Týmové a sezónní agregace stejné definice smějí kombinovat pouze sémanticky kompatibilní verze.'
}

Table player_match_statistics {
  result_revision_id uuid [not null]
  player_id uuid [not null]
  statistic_definition_id uuid [not null]
  statistic_definition_version_id uuid [not null]
  integer_value bigint
  decimal_value numeric(20,6)
  boolean_value boolean
  text_value varchar(1000)
  recorded_at timestamptz [not null]
  recorded_by uuid [not null, ref: > users.id]
  indexes {
    (player_id, statistic_definition_id, result_revision_id)
    (result_revision_id, player_id, statistic_definition_id) [pk]
  }
  checks {
    `num_nonnulls(integer_value, decimal_value, boolean_value, text_value) = 1`
    `decimal_value IS NULL OR decimal_value NOT IN ('NaN'::numeric, 'Infinity'::numeric, '-Infinity'::numeric)`
  }
  Note: 'Jedna typovaná hodnota statistiky hráče v konkrétní revizi výsledku, s přesnou verzí definice. Chybějící řádek není nula. Snapshot match_result_players musí mít played=true a docházku PRESENT/LATE, jeho tým musí být stranou zápasu a sport definice musí souhlasit. Potvrzené hodnoty se neopravují UPDATE/DELETE; změna či odstranění statistiky vyžaduje novou revizi výsledku se snapshotem všech zbývajících částí, hráčů a hodnot. Oficiální agregace používají pouze matches.active_result_revision_id.'
}

Table fee_assessments {
  id uuid [pk]
  version bigint [not null, default: 0]
  person_id uuid [not null, ref: > persons.id]
  season_id uuid [not null, ref: > seasons.id]
  title varchar(160) [not null]
  amount numeric(14,2) [not null]
  currency char(3) [not null, default: 'CZK']
  due_on date [not null]
  cancelled boolean [not null, default: false]
  created_by uuid [not null, ref: > users.id]
  indexes {
    (person_id, season_id)
    due_on
  }
  checks {
    `version >= 0`
    `currency ~ '^[A-Z]{3}$'`
    `amount > 0 AND amount NOT IN ('NaN'::numeric, 'Infinity'::numeric, '-Infinity'::numeric)`
  }
  Note: 'Předpis příspěvku pro osobu a sezónu s jednou splatností. Stav určuje součet nezrušených fee_payments; částečné úhrady jsou povolené. Součet nesmí překročit částku ani být kladný u zrušeného předpisu. Po první úhradě se osoba, sezóna a měna nemění. Částku nelze snížit pod uhrazený součet. Zápis, oprava i výzva používají zámek klubu. Splátkové kalendáře, slevy, vratky a odměny se neevidují.'
}

Table fee_payments {
  id uuid [pk]
  fee_assessment_id uuid [not null, ref: > fee_assessments.id]
  amount numeric(14,2) [not null]
  paid_on date [not null]
  reference varchar(160)
  recorded_at timestamptz [not null]
  recorded_by uuid [not null, ref: > users.id]
  cancelled_at timestamptz
  cancelled_by uuid [ref: >? users.id]
  cancellation_reason varchar(500)
  indexes { fee_assessment_id }
  checks {
    `amount > 0 AND amount NOT IN ('NaN'::numeric, 'Infinity'::numeric, '-Infinity'::numeric)`
    `(cancelled_at IS NULL AND cancelled_by IS NULL AND cancellation_reason IS NULL) OR (cancelled_at IS NOT NULL AND cancelled_by IS NOT NULL AND cancellation_reason IS NOT NULL AND length(trim(cancellation_reason)) > 0 AND cancelled_at >= recorded_at)`
  }
  Note: 'Skutečnou platbu ručně eviduje administrátor. Osoba a měna vyplývají z předpisu. Částka ani předpis se nepřepisují; chybný záznam se stornuje s důvodem a případně nahradí novým. Audit se zapíše ve stejné transakci. Storno nevrací peníze; platební brána se nepoužívá.'
}

Table conversations {
  id uuid [pk]
  title varchar(160)
  team_season_id uuid [not null, ref: > team_seasons.id]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  Note: 'Přímá nebo skupinová konverzace v sezónním týmu s určenými účastníky. Čtení i zápis pod zámkem klubu ověřují účast a aktuální vztah podle database.md; historická vazba sama nestačí.'
}

Table conversation_participants {
  conversation_id uuid [not null, ref: > conversations.id]
  user_id uuid [not null, ref: > users.id]
  joined_at timestamptz [not null]
  left_at timestamptz
  indexes {
    (user_id, conversation_id)
    (conversation_id, user_id) [pk]
  }
  checks {
    `left_at IS NULL OR left_at >= joined_at`
  }
  Note: 'Aktivní účast vyžaduje left_at IS NULL a aktuální oprávnění k týmu. Odchod je konečný; řádek zůstává kvůli autorství. Další komunikace vyžaduje novou konverzaci. Účastník čte zprávy až od joined_at.'
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null]
  author_id uuid [not null]
  body varchar(5000) [not null]
  sent_at timestamptz [not null]
  indexes {
    (conversation_id, sent_at, id)
  }
  checks {
    `length(trim(body)) > 0`
  }
  Note: 'Autor musí patřit do konverzace; při odeslání musí mít aktivní účast a aktuální oprávnění. Ukončená účast se nemaže.'
}

Table notifications {
  id uuid [pk]
  type notification_type [not null]
  event_id uuid [ref: >? events.id]
  fee_assessment_id uuid [ref: >? fee_assessments.id]
  title varchar(160) [not null]
  body varchar(2000) [not null]
  deduplication_key varchar(200) [not null, unique]
  created_at timestamptz [not null]
  checks {
    `(type IN ('FEE_DUE_SOON', 'FEE_OVERDUE') AND fee_assessment_id IS NOT NULL AND event_id IS NULL) OR (type NOT IN ('FEE_DUE_SOON', 'FEE_OVERDUE') AND event_id IS NOT NULL AND fee_assessment_id IS NULL)`
  }
  Note: 'Neměnné oznámení změny nebo výzvy, společné pro adresáty. Deduplikační klíč určuje operaci a verzi; u příspěvku předpis, splatnost a druh výzvy. Text neobsahuje soukromé údaje adresáta.'
}

Table notification_deliveries {
  notification_id uuid [not null, ref: > notifications.id]
  recipient_id uuid [not null, ref: > users.id]
  delivered_at timestamptz [not null]
  read_at timestamptz
  indexes {
    (notification_id, recipient_id) [pk]
    (recipient_id, read_at, delivered_at)
  }
  checks {
    `read_at IS NULL OR read_at >= delivered_at`
  }
  Note: 'Doručení jednomu enabled účtu; PK brání duplicitě. FEE_DUE_SOON a FEE_OVERDUE se CHILD účtu nikdy nedoručí, ani pro vlastní příspěvek; adresáty jsou enabled STANDARD účet samotného člena, oprávnění STANDARD rodiče a administrátoři. Backend kontroluje typ adresáta před zápisem i čtením schránky. Delivered_at nesmí předcházet vytvoření oznámení. Schránku a přečtení zpřístupňuje recipient_id, otevření cíle vyžaduje samostatnou kontrolu oprávnění.'
}

Ref: matches.(competition_season_id, match_format_id) >? competition_seasons.(id, match_format_id)
Ref: events.id - matches.event_id
Ref: event_participants.(event_id, team_season_id) > event_teams.(event_id, team_season_id)
Ref: matches.(competition_season_id, home_team_season_id) >? competition_entries.(competition_season_id, team_season_id)
Ref: matches.(competition_season_id, away_team_season_id) >? competition_entries.(competition_season_id, team_season_id)
Ref: matches.(active_result_revision_id, event_id) >? match_result_revisions.(id, event_id)
Ref: match_result_revisions.(supersedes_revision_id, event_id) >? match_result_revisions.(id, event_id)
Ref: match_result_players.(result_revision_id, event_id) > match_result_revisions.(id, event_id)
Ref: match_result_players.(event_id, player_id) > event_participants.(event_id, player_id)
Ref: player_match_statistics.(result_revision_id, player_id) > match_result_players.(result_revision_id, player_id)
Ref: player_match_statistics.(statistic_definition_version_id, statistic_definition_id) > statistic_definition_versions.(id, statistic_definition_id)
Ref: competition_tie_decisions.(supersedes_decision_id, competition_season_id, results_revision) >? competition_tie_decisions.(id, competition_season_id, results_revision)
Ref: competition_tie_decision_entries.(decision_id, competition_season_id) > competition_tie_decisions.(id, competition_season_id)
Ref: competition_tie_decision_entries.(competition_season_id, team_season_id) > competition_entries.(competition_season_id, team_season_id)
Ref: messages.(conversation_id, author_id) > conversation_participants.(conversation_id, user_id)

TableGroup clenove {
  persons
  users
  player_profiles
  guardian_links
}
TableGroup tymy_a_sezony {
  club
  sports
  seasons
  teams
  team_seasons
  player_team_memberships
  coach_team_memberships
}
TableGroup akce_a_ucast {
  events
  event_teams
  event_participants
}
TableGroup souteze {
  competitions
  competition_seasons
  match_formats
  competition_point_rules
  competition_forfeit_rules
  competition_ranking_criteria
  competition_entries
  competition_tie_decisions
  competition_tie_decision_entries
  matches
  match_result_revisions
  match_periods
  match_result_players
}
TableGroup statistiky {
  statistic_definitions
  statistic_definition_versions
  player_match_statistics
}
TableGroup prispevky {
  fee_assessments
  fee_payments
}
TableGroup komunikace {
  conversations
  conversation_participants
  messages
  notifications
  notification_deliveries
}

Table audit_log {
  id uuid [pk]
  actor_user_id uuid [ref: >? users.id]
  occurred_at timestamptz [not null]
  action varchar(80) [not null]
  entity_type varchar(60) [not null]
  entity_key jsonb [not null, note: 'Objekt s názvy a kanonickými hodnotami všech sloupců PK cíle, bez kopií osobních údajů.']
  reason varchar(500)
  indexes {
    (entity_type, entity_key, occurred_at)
    (actor_user_id, occurred_at)
  }
  checks {
    `length(trim(action)) > 0`
    `length(trim(entity_type)) > 0`
    `jsonb_typeof(entity_key) = 'object' AND entity_key <> '{}'::jsonb`
  }
  Note: 'Neměnný záznam změny role, vztahu, příspěvku, úhrady nebo opravy historie ve stejné transakci jako změna. NULL actor_user_id označuje systém. Entity_type je název tabulky, entity_key její úplný PK; backend ověřuje povolenou tabulku, názvy a typy částí klíče. Jeden řádek označuje jeden cíl a zůstává i po jeho odstranění, proto nemá FK na cíl. Autora, čas, akci a klíč zapisuje server. Neobsahuje hesla, session, soukromé zprávy ani kopie osobních údajů. Číst smí administrátor; dobu uchování je třeba stanovit před provozem. Nenahrazuje doménové match_result_revisions/statistic_definition_versions ani provozní logy; historické hodnoty jsou ve vlastních neměnných revizích.'
}

TableGroup audit {
  audit_log
}
