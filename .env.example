# Development samples only. Replace the password before running.
POSTGRES_DB=sport_club
POSTGRES_USER=sport_club
POSTGRES_PASSWORD=replace_with_a_local_password
DB_HOST=localhost
DB_PORT=5432
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
# Optional, private one-time first ADMIN setup; empty disables claiming ownership.
# Choose a long random value before initial setup. Never use NEXT_PUBLIC_* for it.
CLUB_SETUP_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# HTTPS deployment only (docker-compose.prod.yml):
PUBLIC_HOST=club.example.org
ACME_EMAIL=admin@example.org
